# Stander, the hologram assistant (components/agent + app/api/hub-agent).
#
# Without any key the assistant still works: it answers the curated core
# knowledge in lib/agent/standx-knowledge.ts, routes explicit navigation
# requests, and links official sources. A provider is only for broader turns.
#
# Providers are tried in the order below and every one is OpenAI-compatible, so
# adding another is configuration rather than code. The chain exists because
# these are free tiers — when one returns 429 the next takes over, and when all
# of them are spent the curated answers do. The hub never goes down for this.

# --- Provider 1: Groq --------------------------------------------------------
# Free tier: 30 requests/minute, 1,000/day on openai/gpt-oss-120b.
# Key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides.
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Provider 2: OpenRouter --------------------------------------------------
# Free tier: 20 requests/minute, 50/day (1,000/day once $10 of credit has ever
# been purchased). The default model is the same family as Groq's on purpose —
# a mid-conversation failover should not change Stander's voice.
# Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional overrides. Free models change; the current list of free models that
# support tool calling is:
#   curl "https://openrouter.ai/api/v1/models?supported_parameters=tools"
# OPENROUTER_MODEL=openai/gpt-oss-20b:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Per-visitor budget ------------------------------------------------------
# Signs the cookie that counts a visitor's questions (20 answered normally, 15
# more paced, then curated answers until the next day). It cannot identify
# anyone and is not meant to: it stops one visitor burning the daily quota by
# accident. See the reasoning in lib/agent/visitor-quota.ts.
#
# LEAVING THIS EMPTY DISABLES PER-VISITOR LIMITING. The provider's own rate
# limit and the offline fallback remain, so nothing breaks — but a single
# visitor can then spend the whole day's quota.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STANDX_AGENT_COOKIE_SECRET=

# --- Voice -------------------------------------------------------------------
# Experimental browser speech controls. Disabled by default because recognition
# quality, permissions, and available voices vary significantly by browser.
NEXT_PUBLIC_STANDER_VOICE=0
