# Stander, the hologram assistant (components/agent + app/api/hub-agent).
#
# Without any key the assistant still works: it answers the curated core
# knowledge in lib/agent/standx-knowledge.ts, routes explicit navigation
# requests, and links official sources. A provider is only for broader turns.
#
# Providers are tried in the order below and every one is OpenAI-compatible, so
# adding another is configuration rather than code. The chain exists because
# these are free tiers — when one returns 429 the next takes over, and when all
# of them are spent the curated answers do. The hub never goes down for this.

# --- Provider 1: Groq --------------------------------------------------------
# The primary, so it runs the stronger model.
#
# The limit that actually binds is TOKENS per minute, not requests: 12,000/min
# on the default model, shared by every visitor. Requests are effectively
# unlimited by comparison (1,000/min). That is why the system prompt is built
# per question by lib/agent/retrieval.ts instead of carrying the whole knowledge
# base — with the whole base, ONE question exceeded the minute's budget.
#
# When it is exceeded Groq answers `401 Invalid API Key` as often as a truthful
# 429, on a key that works. Do not chase the key; check the prompt size first
# (npm run retrieval:check).
#
# Key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides. If you change the model, test it WITH TOOLS before trusting
# it. `llama-3.3-70b-versatile` has the largest token allowance here and answers
# plain questions well, but fails every tool-enabled request with 400
# `tool_use_failed` — a smoke test without tools passes and the assistant is
# still broken. The bar is a real answer to a real question:
#   curl https://api.groq.com/openai/v1/chat/completions \
#     -H "Authorization: Bearer $GROQ_API_KEY" -H 'content-type: application/json' \
#     -d '{"model":"<id>","messages":[{"role":"user","content":"ok"}],"max_tokens":5}'
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Provider 2: OpenRouter --------------------------------------------------
# Free tier: 20 requests/minute, 50/day (1,000/day once $10 of credit has ever
# been purchased). A backup at 1/20th the daily volume, so it runs a smaller
# model: a fallback that sounds slightly different for a few turns beats a
# fallback that cannot answer.
# Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional overrides. Free models come and go; list the current tool-capable
# ones, then filter for ":free":
#   curl "https://openrouter.ai/api/v1/models?supported_parameters=tools"
# Not every one of them accepts this tool schema — `google/gemma-4-31b-it:free`
# rejects it with a 400 — so try a real question before switching.
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Per-visitor budget ------------------------------------------------------
# Signs the cookie that counts a visitor's questions (20 answered normally, 15
# more paced, then curated answers until the next day). It cannot identify
# anyone and is not meant to: it stops one visitor burning the daily quota by
# accident. See the reasoning in lib/agent/visitor-quota.ts.
#
# LEAVING THIS EMPTY DISABLES PER-VISITOR LIMITING. The provider's own rate
# limit and the offline fallback remain, so nothing breaks — but a single
# visitor can then spend the whole day's quota.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STANDX_AGENT_COOKIE_SECRET=

# --- Voice -------------------------------------------------------------------
# Experimental browser speech controls. Disabled by default because recognition
# quality, permissions, and available voices vary significantly by browser.
NEXT_PUBLIC_STANDER_VOICE=0
