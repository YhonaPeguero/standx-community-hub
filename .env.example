# Hologram assistant (components/agent + app/api/hub-agent).
#
# Without a key the assistant still works: it falls back to the offline
# keyword brain in lib/agent/local-fallback.ts, which routes visitors to the
# right section and links the right doc page but cannot converse.
#
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5.
# STANDX_AGENT_MODEL=claude-opus-5
